# Copy to `.env` (chmod 600). ONLY needed for mode: live. NEVER commit .env (it is in .gitignore).
# Use an HL API/AGENT wallet (create in the HL UI: "API" -> generate agent wallet), NOT your main MetaMask key.
# The agent wallet can trade your account but cannot withdraw — the correct key to put on a server.
HL_PRIVATE_KEY=
HL_ACCOUNT_ADDRESS=
